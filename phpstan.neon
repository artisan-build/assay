includes:
    - ./vendor/larastan/larastan/extension.neon
    - ./phpstan-baseline.neon

parameters:
    paths:
        - app/
        - packages/assay-client/src/
        - packages/assay-contracts/src/
    excludePaths:
        - **/*Test.php
    scanFiles:
        - _ide_helper_models.php
    level: 6
    treatPhpDocTypesAsCertain: false
